{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChoiTerm",
  "version": "0.9.0",
  "identifier": "com.choidev.choiterm.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "choidev",
    "shortDescription": "PC와 폰이 같이 쓰는 터미널",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      }
    },
    "resources": {
      "../bundle/server/": "server/",
      "../bundle/node/": "node/"
    }
  },
  "plugins": {},
  "mainBinaryName": "ChoiTerm"
}
